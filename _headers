/*
  ! Access-Control-Allow-Origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; worker-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/svg+xml

/icon.svg
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/svg+xml

/icon-maskable.svg
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/svg+xml

/manifest.webmanifest
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: application/manifest+json

/og.png
  Cache-Control: public, max-age=604800, must-revalidate

/robots.txt
  Cache-Control: public, max-age=604800, must-revalidate

/llms.txt
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/plain; charset=utf-8

/AGENTS.md
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/markdown; charset=utf-8

/index.md
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/markdown; charset=utf-8

/sitemap.md
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: text/markdown; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=604800, must-revalidate

/LICENSE
  Cache-Control: public, max-age=604800, must-revalidate

/css/styles.*.css
  Cache-Control: public, max-age=31536000, immutable

/scripts/app.*.js
  Cache-Control: public, max-age=31536000, immutable

/scripts/scene.*.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800, must-revalidate

/images/*
  Cache-Control: public, max-age=604800, must-revalidate

/images/scene-poster-*.*.webp
  Cache-Control: public, max-age=31536000, immutable
